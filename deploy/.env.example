# 复制为 .env 后修改；不要把真实值提交到仓库
DB_USER=root
DB_PASSWORD=change-me-db
DB_NAME=dafu

MINIO_USER=dafu-minio
MINIO_PASSWORD=change-me-minio
MINIO_BUCKET=dafu-images

JWT_SECRET=change-me-jwt
# AES-256-GCM 主密钥；不配会回落 JWT_SECRET，生产必须单独配
AI_ENC_KEY=change-me-ai-enc

# 留空则 AI 走降级
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# 福大 CAS：BASE_URL 与 SERVICE 均留空 → 演示桩模式（学号 + 初始口令）
FZU_CAS_BASE_URL=
FZU_CAS_SERVICE=
FZU_CAS_VALIDATE_PATH=/serviceValidate
# 演示桩初始口令；公网必须改为不公开的强口令（默认 FZU521 仅演示用）
FZU_CAS_INITIAL_PASSWORD=FZU521

# 镜像 tag；与 deploy/images 中保存的 tag 一致
DAFU_TAG=v1.0-alpha
